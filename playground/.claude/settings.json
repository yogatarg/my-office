{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node C:/laragon/www/my-office/hooks/send-event.js",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node C:/laragon/www/my-office/hooks/send-event.js",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node C:/laragon/www/my-office/hooks/send-event.js",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/laragon/www/my-office/hooks/send-event.js",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/laragon/www/my-office/hooks/send-event.js",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node C:/laragon/www/my-office/hooks/send-event.js",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node C:/laragon/www/my-office/hooks/send-event.js",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node C:/laragon/www/my-office/hooks/send-event.js",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node C:/laragon/www/my-office/hooks/send-event.js",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "permissions": {
    "additionalDirectories": [
      "C:/laragon/www",
      "C:/laragon/myra-studio"
    ],
    "allow": [
      "Bash(python C:/laragon/www/my-office/scripts/qa-chrome.py *)",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude-in-chrome__tabs_create_mcp",
      "mcp__claude-in-chrome__list_connected_browsers",
      "mcp__claude-in-chrome__select_browser",
      "mcp__claude-in-chrome__navigate",
      "mcp__claude-in-chrome__read_page",
      "mcp__claude-in-chrome__get_page_text",
      "mcp__claude-in-chrome__find",
      "mcp__claude-in-chrome__resize_window",
      "mcp__claude-in-chrome__read_console_messages"
    ],
    "ask": [
      "Bash(python C:/laragon/www/my-office/scripts/qa-chrome.py --luar*)",
      "Bash(python C:/laragon/www/my-office/scripts/qa-chrome.py * --luar*)",
      "Bash(npm run posting:*)",
      "Bash(npm --prefix C:/laragon/myra-studio/marketing/posting run posting:*)",
      "Bash(node scripts/posting.mjs:*)",
      "Bash(node C:/laragon/myra-studio/marketing/posting/scripts/posting.mjs:*)",
      "Bash(npm run unggah:*)",
      "Bash(npm --prefix C:/laragon/myra-studio/konten/unggah run unggah:*)",
      "Bash(node scripts/unggah.mjs:*)",
      "Bash(node C:/laragon/myra-studio/konten/unggah/scripts/unggah.mjs:*)"
    ]
  }
}
